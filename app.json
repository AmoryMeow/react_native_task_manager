{
  "expo": {
    "name": "react_native_task_manager",
    "slug": "react_native_task_manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reactnativetaskmanager",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
